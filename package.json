{
  "name": "portal-lomba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate-env.ts && tsx scripts/database-preflight.ts build && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/database-preflight.ts test && vitest run --config vitest.integration.config.mts",
    "test:e2e": "tsx scripts/database-preflight.ts test && playwright test",
    "test:watch": "vitest",
    "ci:quick": "node scripts/ci-local.mjs quick",
    "ci:security": "node scripts/ci-local.mjs security",
    "ci:full": "node scripts/ci-local.mjs full",
    "ci:local": "npm run ci:full",
    "db:generate": "prisma generate",
    "db:preflight": "tsx scripts/database-preflight.ts",
    "db:migrate": "tsx scripts/database-preflight.ts migrate-dev && prisma migrate dev",
    "db:deploy": "tsx scripts/database-preflight.ts migrate-deploy && prisma migrate deploy",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "statistics:reconcile": "tsx scripts/reconcile-statistics.ts",
    "env:check": "tsx scripts/validate-env.ts",
    "load:test": "node scripts/load-test.mjs",
    "load:phase23": "tsx scripts/phase23-workflow-load-test.ts",
    "load:realtime": "node scripts/realtime-load-test.mjs",
    "seed:phase23-uat": "tsx scripts/seed-phase23-human-uat.ts",
    "storage:migrate": "tsx scripts/migrate-object-storage.ts",
    "alerts:check": "tsx scripts/check-operational-alerts.ts",
    "regions:import": "tsx scripts/import-indonesia-regions.ts",
    "benchmark:discovery": "tsx scripts/benchmark-discovery.ts",
    "benchmark:discovery:phase17": "tsx scripts/benchmark-discovery-phase17.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.5",
      "uuid": "^11.1.1"
    }
  }
}
