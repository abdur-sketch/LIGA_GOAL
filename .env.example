DATABASE_URL="postgresql://liga_goal:change-me@localhost:5432/liga_goal?schema=public"
LIGA_GOAL_ENVIRONMENT="local"
# Fail-closed database write guard. Keep lists exact; do not put production/legacy targets here.
DATABASE_NAME_ALLOWLIST="liga_goal,liga_goal_local_shadow"
DATABASE_HOST_ALLOWLIST="localhost"
SHADOW_DATABASE_URL="postgresql://liga_goal:change-me@localhost:5432/liga_goal_local_shadow?schema=public"
# Set only for the lifetime of an intentional migration/test command.
# CONFIRM_DATABASE_MUTATION="YES"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Local/staging adapter only. Use mounted persistent storage or replace with S3 in production.
UPLOAD_DIR=".uploads"
PRIVATE_UPLOAD_DIR=".private-uploads"
TRUSTED_PROXY_HOPS="0"
METRICS_TOKEN="replace-with-at-least-32-random-characters"
STORAGE_DRIVER="local"
QUARANTINE_UPLOAD_DIR=".quarantine-uploads"
MALWARE_SCANNER="signature"
# ALLOW_LOCAL_RECOVERY_PREVIEW="true" # Local testing only; never enable in production.
