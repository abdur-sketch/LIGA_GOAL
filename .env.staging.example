DATABASE_URL="postgresql://app:replace-me@staging-db.invalid:5432/liga_goal_staging?schema=public"
LIGA_GOAL_ENVIRONMENT="staging"
APP_VERSION="0.1.0"
APP_COMMIT_SHA="replace-with-deployed-git-sha"
DATABASE_NAME_ALLOWLIST="liga_goal_staging"
DATABASE_HOST_ALLOWLIST="staging-db.invalid"
# Staging uses migrate deploy. Never run migrate dev or configure its shadow against staging.
NEXTAUTH_URL="https://staging.example.invalid"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
TRUSTED_PROXY_HOPS="1"
METRICS_TOKEN="replace-with-at-least-32-random-characters"
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://object-storage.example.invalid"
S3_REGION="replace-me"
S3_BUCKET_PUBLIC="liga-goal-staging-public"
S3_BUCKET_PRIVATE="liga-goal-staging-private"
S3_BUCKET_QUARANTINE="liga-goal-staging-quarantine"
S3_ACCESS_KEY_ID="from-secret-manager"
S3_SECRET_ACCESS_KEY="from-secret-manager"
S3_FORCE_PATH_STYLE="false"
S3_SERVER_SIDE_ENCRYPTION="AES256"
MALWARE_SCANNER="clamav"
CLAMAV_HOST="approved-scanner.internal"
CLAMAV_PORT="3310"
EMAIL_PROVIDER_ENDPOINT="https://mail-provider.example.invalid/send"
EMAIL_PROVIDER_TOKEN="from-secret-manager"
ALERT_WEBHOOK_URL="https://alerts.example.invalid/events"
ALERT_WEBHOOK_TOKEN="from-secret-manager"
