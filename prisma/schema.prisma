generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION
  ONGOING
  COMPLETED
  ARCHIVED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ParticipationStatus {
  PENDING
  APPROVED
  WITHDRAWN
}

enum VenueStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum OfficialRole {
  HEAD_COACH
  ASSISTANT_COACH
  CLUB_MANAGER
  REFEREE
  ASSISTANT_REFEREE
  MATCH_COMMISSIONER
  OTHER
}

enum CompetitionFormat {
  SINGLE_ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
  GROUP_STAGE
  SINGLE_ELIMINATION
  GROUP_AND_KNOCKOUT
}

enum MatchStatus {
  DRAFT
  SCHEDULED
  LINEUP_CONFIRMED
  LIVE_FIRST_HALF
  HALF_TIME
  LIVE_SECOND_HALF
  EXTRA_TIME
  PENALTY_SHOOTOUT
  FINISHED_PENDING_APPROVAL
  OFFICIAL
  POSTPONED
  CANCELLED
  ABANDONED
}

enum MatchEventType {
  KICK_OFF
  GOAL
  ASSIST
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISSED
  YELLOW_CARD
  SECOND_YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  HALF_TIME
  SECOND_HALF_KICK_OFF
  FULL_TIME
  EXTRA_TIME_START
  EXTRA_TIME_END
  SHOOTOUT_GOAL
  SHOOTOUT_MISSED
}

enum MatchPeriod {
  PRE_MATCH
  FIRST_HALF
  HALF_TIME
  SECOND_HALF
  EXTRA_TIME_FIRST
  EXTRA_TIME_BREAK
  EXTRA_TIME_SECOND
  PENALTY_SHOOTOUT
  FULL_TIME
}

enum LineupStatus {
  DRAFT
  CONFIRMED
}

enum LineupRole {
  STARTER
  SUBSTITUTE
}

enum MatchApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchCorrectionStatus {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
}

enum RealtimeOutboxStatus {
  PENDING
  PUBLISHED
}

enum StatisticsSnapshotStatus {
  BUILDING
  PUBLISHED
  FAILED
}

enum StatisticsJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum StandingResolutionStatus {
  RESOLVED
  UNRESOLVED
  MANUAL
}

enum QualificationStatus {
  UNDECIDED
  QUALIFIED
  ELIMINATED
}

enum StageType {
  ROUND_ROBIN
  GROUP
  KNOCKOUT
}

enum DrawMethod {
  MANUAL
  RANDOM
  SEEDED
}

enum FixtureGenerationStatus {
  DRAFT
  PREVIEW
  VALIDATED
  PUBLISHED
  CANCELLED
}

enum BracketSide {
  HOME
  AWAY
}

enum BracketTieStatus {
  PENDING
  READY
  COMPLETED
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  CANCELLED
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  RETIRED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EligibilityResult {
  ELIGIBLE
  INELIGIBLE
  PENDING_REVIEW
}

enum PlayerDocumentType {
  PHOTO
  IDENTITY
  AGE_PROOF
  PARENTAL_CONSENT
  ADDITIONAL
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RosterStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  INJURED
  RECOVERING
  SUSPENDED
  UNAVAILABLE
}

enum TransferType {
  PERMANENT
  LOAN
  LOAN_RETURN
  FREE_AGENT_SIGNING
  REGISTRATION_RELEASE
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SOURCE_CLUB_APPROVED
  DESTINATION_CLUB_APPROVED
  COMPETITION_APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum TransferApprovalStep {
  SOURCE_CLUB
  DESTINATION_CLUB
  COMPETITION
  OVERRIDE
}

enum TransferApprovalStatus {
  APPROVED
  REJECTED
}

enum TransferWindowStatus {
  OPEN
  CLOSED
}

enum InjuryStatus {
  OPEN
  RECOVERING
  CLEARED
  CLOSED
}

enum ClearanceStatus {
  APPROVED
  REVOKED
}

enum DisciplinaryCaseStatus {
  OPEN
  DECIDED
  APPEALED
  CLOSED
}

enum DisciplinaryDecisionType {
  WARNING
  MATCH_BAN
  DATE_SUSPENSION
  POINT_PENALTY
  DISMISSED
}

enum SuspensionType {
  AUTOMATIC
  MANUAL
}

enum SuspensionStatus {
  ACTIVE
  SERVED
  CANCELLED
}

enum AppealStatus {
  NONE
  PENDING
  UPHELD
  REJECTED
  WITHDRAWN
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PublicFollowType {
  COMPETITION
  CLUB
  MATCH
}

enum NotificationType {
  MATCH_STARTING_SOON
  MATCH_STARTED
  GOAL_SCORED
  HALF_TIME
  FULL_TIME
  OFFICIAL_RESULT
  SCHEDULE_CHANGED
  MATCH_POSTPONED
  MATCH_CANCELLED
  COMPETITION_ANNOUNCEMENT
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  APPROVE
  REJECT
  EXPORT
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  name                        String
  passwordHash                String
  image                       String?
  isPlatformAdmin             Boolean                      @default(false)
  isActive                    Boolean                      @default(true)
  sessionVersion              Int                          @default(0)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletedAt                   DateTime?
  memberships                 OrganizationMember[]
  overrides                   UserPermission[]
  auditLogs                   AuditLog[]                   @relation("AuditActor")
  ownedOrganizations          Organization[]               @relation("OrganizationOwner")
  approvedRegistrations       PlayerRegistration[]         @relation("RegistrationApprover")
  uploadedPlayerDocuments     PlayerDocument[]             @relation("DocumentUploader")
  playerDocumentVerifications PlayerDocumentVerification[] @relation("DocumentVerifier")
  registrationHistory         RegistrationHistory[]        @relation("RegistrationHistoryActor")
  fixtureGenerations          FixtureGeneration[]          @relation("FixtureGenerator")
  createdMatches              Match[]                      @relation("MatchCreator")
  updatedMatches              Match[]                      @relation("MatchUpdater")
  fixturePublications         FixturePublication[]         @relation("FixturePublisher")
  matchScheduleHistory        MatchScheduleHistory[]       @relation("ScheduleHistoryActor")
  confirmedLineups            MatchLineup[]                @relation("LineupConfirmer")
  operatedMatchEvents         MatchEvent[]                 @relation("MatchEventOperator")
  matchEventRevisions         MatchEventRevision[]         @relation("MatchEventRevisionActor")
  matchApprovals              MatchApproval[]              @relation("MatchApprover")
  requestedMatchCorrections   MatchCorrection[]            @relation("MatchCorrectionRequester")
  reviewedMatchCorrections    MatchCorrection[]            @relation("MatchCorrectionReviewer")
  lineupRevisions             MatchLineupRevision[]
  computedStatisticsSnapshots StatisticsSnapshot[]         @relation("StatisticsSnapshotComputer")
  approvedPointAdjustments    PointAdjustment[]            @relation("PointAdjustmentApprover")
  statisticsRevisions         StatisticsRevision[]         @relation("StatisticsRevisionActor")
  createdTransfers            TransferRequest[]            @relation("TransferCreator")
  transferApprovals           TransferApproval[]           @relation("TransferApprovalActor")
  transferHistory             TransferHistory[]            @relation("TransferHistoryActor")
  transferOverrides           TransferRequest[]            @relation("TransferOverrideActor")
  createdTransferWindows      TransferWindow[]             @relation("TransferWindowCreator")
  availabilityChanges         PlayerAvailability[]         @relation("AvailabilityCreator")
  createdInjuries             InjuryCase[]                 @relation("InjuryCreator")
  injuryProgressUpdates       InjuryProgress[]             @relation("InjuryProgressActor")
  medicalClearances           MedicalClearance[]           @relation("MedicalClearanceActor")
  createdDisciplinaryCases    DisciplinaryCase[]           @relation("DisciplinaryCaseCreator")
  disciplinaryDecisions       DisciplinaryDecision[]       @relation("DisciplinaryDecisionActor")
  disciplinaryAppeals         DisciplinaryAppeal[]         @relation("DisciplinaryAppealActor")
  issuedSuspensions           Suspension[]                 @relation("SuspensionIssuer")
  createdArticles             Article[]                    @relation("ArticleCreator")
  updatedArticles             Article[]                    @relation("ArticleUpdater")
  articleRevisions            ArticleRevision[]
  createdNotifications        Notification[]               @relation("NotificationCreator")
  passwordResetTokens         PasswordResetToken[]
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model Organization {
  id                      String                    @id @default(cuid())
  name                    String
  slug                    String                    @unique
  status                  OrganizationStatus        @default(PENDING)
  logoUrl                 String?
  contactEmail            String?
  contactPhone            String?
  address                 String?
  ownerId                 String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  memberships             OrganizationMember[]
  roles                   Role[]
  competitions            Competition[]
  clubs                   Club[]
  venues                  Venue[]
  auditLogs               AuditLog[]
  owner                   User?                     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  officials               Official[]
  competitionClubs        CompetitionClub[]
  players                 Player[]
  playerRegistrations     PlayerRegistration[]
  playerDocuments         PlayerDocument[]
  rosterEntries           RosterEntry[]
  eligibilityChecks       EligibilityCheck[]
  registrationHistory     RegistrationHistory[]
  stages                  Stage[]
  groups                  Group[]
  groupMemberships        GroupMembership[]
  fixtureGenerations      FixtureGeneration[]
  fixtureDrafts           FixtureDraft[]
  matches                 Match[]
  matchAssignments        MatchOfficialAssignment[]
  scheduleHistory         MatchScheduleHistory[]
  bracketTies             BracketTie[]
  bracketSlots            BracketSlot[]
  fixturePublications     FixturePublication[]
  matchLineups            MatchLineup[]
  matchLineupPlayers      MatchLineupPlayer[]
  matchEvents             MatchEvent[]
  matchResults            MatchResult[]
  matchApprovals          MatchApproval[]
  matchCorrections        MatchCorrection[]
  matchRealtimeOutbox     MatchRealtimeOutbox[]
  bracketLegs             BracketLeg[]
  statisticsSnapshots     StatisticsSnapshot[]
  pointAdjustments        PointAdjustment[]
  statisticsJobs          StatisticsRecomputeJob[]
  statisticsRevisions     StatisticsRevision[]
  transferWindows         TransferWindow[]
  transferRequests        TransferRequest[]
  transferApprovals       TransferApproval[]
  transferHistory         TransferHistory[]
  playerAvailability      PlayerAvailability[]
  injuryCases             InjuryCase[]
  disciplinaryCases       DisciplinaryCase[]
  suspensions             Suspension[]
  articles                Article[]
  articleRevisions        ArticleRevision[]
  publicFollows           PublicFollow[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  pushSubscriptions       PushSubscription[]

  @@index([status, deletedAt])
  @@index([ownerId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
}

model Role {
  id             String               @id @default(cuid())
  organizationId String?
  name           String
  key            String
  isSystem       Boolean              @default(false)
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  permissions    RolePermission[]

  @@unique([organizationId, key])
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique
  description   String
  roleLinks     RolePermission[]
  userOverrides UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  id             String     @id @default(cuid())
  userId         String
  permissionId   String
  organizationId String
  allowed        Boolean
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, organizationId])
  @@index([organizationId, userId])
}

model Competition {
  id                  String                   @id @default(cuid())
  organizationId      String
  name                String
  slug                String
  description         String?
  logoUrl             String?
  category            String?
  location            String?
  regulations         String?
  format              CompetitionFormat
  status              CompetitionStatus        @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasons             Season[]
  teams               Team[]
  rules               CompetitionRule[]
  articles            Article[]
  clubEntries         CompetitionClub[]
  playerRegistrations PlayerRegistration[]
  fixtureGenerations  FixtureGeneration[]
  matches             Match[]
  bracketTies         BracketTie[]
  statisticsSnapshots StatisticsSnapshot[]
  pointAdjustments    PointAdjustment[]
  statisticsJobs      StatisticsRecomputeJob[]
  transferWindows     TransferWindow[]
  transferRequests    TransferRequest[]
  disciplinaryCases   DisciplinaryCase[]
  suspensions         Suspension[]
  publicFollows       PublicFollow[]
  notifications       Notification[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
}

model Season {
  id                  String                   @id @default(cuid())
  competitionId       String
  name                String
  startsAt            DateTime
  endsAt              DateTime
  isActive            Boolean                  @default(false)
  status              SeasonStatus             @default(DRAFT)
  regulations         String?
  winPoints           Int                      @default(3)
  drawPoints          Int                      @default(1)
  lossPoints          Int                      @default(0)
  tieBreakers         Json                     @default("[\"points\",\"goal_difference\",\"goals_for\"]")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  competition         Competition              @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  stages              Stage[]
  registrations       PlayerRegistration[]
  clubEntries         CompetitionClub[]
  officialAssignments OfficialAssignment[]
  rosterEntries       RosterEntry[]
  fixtureGenerations  FixtureGeneration[]
  matches             Match[]
  statisticsSnapshots StatisticsSnapshot[]
  pointAdjustments    PointAdjustment[]
  statisticsJobs      StatisticsRecomputeJob[]
  transferWindows     TransferWindow[]
  transferRequests    TransferRequest[]
  disciplinaryCases   DisciplinaryCase[]
  suspensions         Suspension[]

  @@unique([competitionId, name])
}

model Stage {
  id                  String               @id @default(cuid())
  organizationId      String
  seasonId            String
  name                String
  sortOrder           Int
  type                StageType            @default(ROUND_ROBIN)
  format              CompetitionFormat    @default(SINGLE_ROUND_ROBIN)
  settings            Json                 @default("{}")
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  season              Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  groups              Group[]
  matches             Match[]
  fixtureGenerations  FixtureGeneration[]
  fixtureDrafts       FixtureDraft[]
  bracketTies         BracketTie[]
  groupMemberships    GroupMembership[]
  statisticsSnapshots StatisticsSnapshot[]
  pointAdjustments    PointAdjustment[]

  @@unique([seasonId, sortOrder])
  @@index([organizationId, seasonId, type])
}

model Group {
  id                  String               @id @default(cuid())
  organizationId      String
  stageId             String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stage               Stage                @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches             Match[]
  memberships         GroupMembership[]
  fixtureDrafts       FixtureDraft[]
  statisticsSnapshots StatisticsSnapshot[]
  pointAdjustments    PointAdjustment[]

  @@unique([stageId, name])
  @@index([organizationId, stageId])
}

model GroupMembership {
  id             String       @id @default(cuid())
  organizationId String
  groupId        String
  stageId        String
  clubId         String
  seed           Int?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  club           Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([stageId, clubId])
  @@unique([groupId, clubId])
  @@index([organizationId, groupId])
}

model CompetitionRule {
  id            String      @id @default(cuid())
  competitionId String
  key           String
  value         Json
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, key])
}

model Club {
  id                   String                @id @default(cuid())
  organizationId       String
  name                 String
  shortName            String
  slug                 String
  logoUrl              String?
  foundedYear          Int?
  city                 String?
  description          String?
  contactEmail         String?
  contactPhone         String?
  homeVenueId          String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teams                Team[]
  players              Player[]
  homeVenue            Venue?                @relation("ClubHomeVenue", fields: [homeVenueId], references: [id], onDelete: SetNull)
  competitionEntries   CompetitionClub[]
  officialAssignments  OfficialAssignment[]
  registrations        PlayerRegistration[]
  rosterEntries        RosterEntry[]
  groupMemberships     GroupMembership[]
  homeFixtureDrafts    FixtureDraft[]        @relation("DraftHomeClub")
  awayFixtureDrafts    FixtureDraft[]        @relation("DraftAwayClub")
  bracketSlots         BracketSlot[]
  standingsRows        StandingsRow[]
  teamStatisticsRows   TeamStatisticsRow[]
  playerStatisticsRows PlayerStatisticsRow[]
  pointAdjustments     PointAdjustment[]
  outgoingTransfers    TransferRequest[]     @relation("TransferSourceClub")
  incomingTransfers    TransferRequest[]     @relation("TransferDestinationClub")
  publicFollows        PublicFollow[]
  notifications        Notification[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@index([homeVenueId])
}

model CompetitionClub {
  id             String              @id @default(cuid())
  organizationId String
  competitionId  String
  seasonId       String
  clubId         String
  status         ParticipationStatus @default(PENDING)
  registeredAt   DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competition    Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season         Season              @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  club           Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([seasonId, clubId])
  @@index([organizationId, competitionId, status])
  @@index([clubId])
}

model Team {
  id             String              @id @default(cuid())
  competitionId  String
  clubId         String
  name           String
  competition    Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  club           Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  homeMatches    Match[]             @relation("HomeTeam")
  awayMatches    Match[]             @relation("AwayTeam")
  wonBracketTies BracketTie[]        @relation("BracketWinner")
  lineups        MatchLineup[]
  lineupPlayers  MatchLineupPlayer[]
  matchEvents    MatchEvent[]
  resultsWon     MatchResult[]       @relation("MatchResultWinner")

  @@unique([competitionId, clubId])
}

model Player {
  id                 String                @id @default(cuid())
  organizationId     String
  activeClubId       String?
  fullName           String
  displayName        String?
  photoUrl           String?
  dateOfBirth        DateTime?
  placeOfBirth       String?
  nationality        String?
  gender             Gender                @default(UNDISCLOSED)
  primaryPosition    String?
  secondaryPositions String[]              @default([])
  preferredFoot      PreferredFoot?
  heightCm           Int?
  weightKg           Float?
  status             PlayerStatus          @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  activeClub         Club?                 @relation(fields: [activeClubId], references: [id], onDelete: SetNull)
  privateProfile     PlayerPrivateProfile?
  registrations      PlayerRegistration[]
  documents          PlayerDocument[]
  availability       PlayerAvailability[]
  lineupEntries      MatchLineupPlayer[]
  matchEvents        MatchEvent[]          @relation("MatchEventPlayer")
  relatedMatchEvents MatchEvent[]          @relation("MatchEventRelatedPlayer")
  statisticsRows     PlayerStatisticsRow[]
  transfers          TransferRequest[]
  injuryCases        InjuryCase[]
  disciplinaryCases  DisciplinaryCase[]
  suspensions        Suspension[]

  @@index([organizationId, activeClubId, deletedAt])
}

model PlayerPrivateProfile {
  id               String   @id @default(cuid())
  playerId         String   @unique
  legalFullName    String?
  address          String?
  guardianName     String?
  guardianContact  String?
  identityLastFour String?
  privateNotes     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerRegistration {
  id                 String                @id @default(cuid())
  organizationId     String
  competitionId      String
  seasonId           String
  clubId             String
  playerId           String
  idempotencyKey     String
  jerseyNumber       Int?
  registrationDate   DateTime              @default(now())
  status             RegistrationStatus    @default(DRAFT)
  verificationStatus VerificationStatus    @default(PENDING)
  eligibilityStatus  EligibilityResult     @default(PENDING_REVIEW)
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competition        Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season             Season                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  club               Club                  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  player             Player                @relation(fields: [playerId], references: [id], onDelete: Restrict)
  approvedBy         User?                 @relation("RegistrationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  documents          PlayerDocument[]
  rosterEntry        RosterEntry?
  history            RegistrationHistory[]
  eligibilityChecks  EligibilityCheck[]
  lineupEntries      MatchLineupPlayer[]

  @@unique([organizationId, idempotencyKey])
  @@index([seasonId, playerId, status])
  @@index([organizationId, competitionId, seasonId, clubId, status], map: "PlayerRegistration_organizationId_competitionId_seasonId_clubId")
  @@index([playerId, registrationDate])
}

model PlayerDocument {
  id                 String                       @id @default(cuid())
  organizationId     String
  playerId           String
  registrationId     String?
  type               PlayerDocumentType
  label              String?
  storageKey         String                       @unique
  originalName       String
  mimeType           String
  sizeBytes          Int
  version            Int                          @default(1)
  isCurrent          Boolean                      @default(true)
  required           Boolean                      @default(false)
  verificationStatus DocumentVerificationStatus   @default(PENDING)
  rejectionNotes     String?
  replacedDocumentId String?
  uploadedById       String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
