model DisciplinaryDecision {
  id           String                   @id @default(cuid())
  caseId       String
  type         DisciplinaryDecisionType
  reason       String
  matchBans    Int?
  startsAt     DateTime?
  endsAt       DateTime?
  pointPenalty Int?
  approvedById String
  createdAt    DateTime                 @default(now())
  case         DisciplinaryCase         @relation(fields: [caseId], references: [id], onDelete: Restrict)
  approvedBy   User                     @relation("DisciplinaryDecisionActor", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model DisciplinaryAppeal {
  id         String           @id @default(cuid())
  caseId     String
  status     AppealStatus     @default(PENDING)
  reason     String
  resolution String?
  actorId    String
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  case       DisciplinaryCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor      User             @relation("DisciplinaryAppealActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([caseId, status, createdAt])
}

model Suspension {
  id                 String              @id @default(cuid())
  organizationId     String
  competitionId      String
  seasonId           String
  playerId           String
  disciplinaryCaseId String?
  type               SuspensionType
  status             SuspensionStatus    @default(ACTIVE)
  appealStatus       AppealStatus        @default(NONE)
  reason             String
  sourceKey          String
  effectiveAt        DateTime
  endsAt             DateTime?
  originalMatchBans  Int?
  remainingMatchBans Int?
  issuedById         String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competition        Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season             Season              @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  player             Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  disciplinaryCase   DisciplinaryCase?   @relation(fields: [disciplinaryCaseId], references: [id], onDelete: Restrict)
  issuedBy           User                @relation("SuspensionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  services           SuspensionService[]

  @@unique([organizationId, sourceKey])
  @@index([organizationId, competitionId, seasonId, playerId, status])
}

model SuspensionService {
  id           String     @id @default(cuid())
