  status     AvailabilityStatus
  publicNote String?
  startsAt   DateTime
  endsAt     DateTime?
  player     Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, startsAt])
}

model StatisticsSnapshot {
  id                  String                   @id @default(cuid())
  organizationId      String
  competitionId       String
  seasonId            String
  stageId             String?
  groupId             String?
  scopeKey            String
  version             Int
  sourceFingerprint   String
  sourceResultVersion Int                      @default(0)
  status              StatisticsSnapshotStatus @default(BUILDING)
  errorMessage        String?
  computedById        String?
  calculatedAt        DateTime                 @default(now())
  publishedAt         DateTime?
  createdAt           DateTime                 @default(now())
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competition         Competition              @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season              Season                   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  stage               Stage?                   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  group               Group?                   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  computedBy          User?                    @relation("StatisticsSnapshotComputer", fields: [computedById], references: [id], onDelete: SetNull)
  standings           StandingsRow[]
  teamStatistics      TeamStatisticsRow[]
  playerStatistics    PlayerStatisticsRow[]
  leaderboards        LeaderboardSnapshot[]
  revisions           StatisticsRevision[]

  @@unique([organizationId, scopeKey, version])
  @@index([organizationId, scopeKey, status, publishedAt])
  @@index([competitionId, seasonId, stageId, groupId])
}

model StandingsRow {
  id                  String                   @id @default(cuid())
  snapshotId          String
  clubId              String
  position            Int
  played              Int
  won                 Int
  drawn               Int
  lost                Int
  goalsFor            Int
  goalsAgainst        Int
  goalDifference      Int
  rawPoints           Int
  adjustmentPoints    Int                      @default(0)
  points              Int
  fairPlayPoints      Int                      @default(0)
  form                Json                     @default("[]")
  resolutionStatus    StandingResolutionStatus @default(RESOLVED)
  qualificationStatus QualificationStatus      @default(UNDECIDED)
  snapshot            StatisticsSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  club                Club                     @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, clubId])
  @@unique([snapshotId, position])
  @@index([clubId, snapshotId])
}

model TeamStatisticsRow {
  id                    String             @id @default(cuid())
  snapshotId            String
  clubId                String
  played                Int
  won                   Int
  drawn                 Int
  lost                  Int
  goalsFor              Int
  goalsAgainst          Int
  goalDifference        Int
  cleanSheets           Int
  homePlayed            Int
  homeWon               Int
  homeDrawn             Int
  homeLost              Int
  awayPlayed            Int
  awayWon               Int
  awayDrawn             Int
  awayLost              Int
