  cleanSheets       Int?
  snapshot          StatisticsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  player            Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  club              Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, playerId, clubId])
  @@index([snapshotId, goals, assists])
  @@index([playerId, clubId])
}

model LeaderboardSnapshot {
