  penaltyGoals      Int
  penaltyMisses     Int
  yellowCards       Int
  secondYellowCards Int
  redCards          Int
  cleanSheets       Int?
  snapshot          StatisticsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
