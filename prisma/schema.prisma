  event     MatchEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor     User       @relation("MatchEventRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([eventId, revision])
  @@index([eventId, createdAt])
}

model MatchResult {
  id             String       @id @default(cuid())
  organizationId String
  matchId        String
