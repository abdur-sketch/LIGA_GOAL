  actor     User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([lineupId, version])
  @@index([lineupId, createdAt])
}

model MatchEvent {
  id              String               @id @default(cuid())
  organizationId  String
  matchId         String
  idempotencyKey  String
  eventType       MatchEventType
  period          MatchPeriod
  teamId          String?
  playerId        String?
  relatedPlayerId String?
  minute          Int
  addedTime       Int                  @default(0)
  payload         Json?
  isValid         Boolean              @default(true)
  revision        Int                  @default(1)
  operatorId      String?
  occurredAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  match           Match                @relation(fields: [matchId], references: [id], onDelete: Restrict)
  team            Team?                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player          Player?              @relation("MatchEventPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  relatedPlayer   Player?              @relation("MatchEventRelatedPlayer", fields: [relatedPlayerId], references: [id], onDelete: Restrict)
  operator        User?                @relation("MatchEventOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  revisions       MatchEventRevision[]

  @@unique([matchId, idempotencyKey])
  @@index([organizationId, matchId, isValid, minute, addedTime])
}

model MatchEventRevision {
  id        String     @id @default(cuid())
  eventId   String
  revision  Int
  actorId   String
  before    Json
  after     Json
  reason    String
