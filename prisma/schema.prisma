  tie            BracketTie   @relation(fields: [tieId], references: [id], onDelete: Restrict)
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@unique([tieId, leg])
  @@index([organizationId, tieId])
}

model BracketSlot {
  id             String       @id @default(cuid())
  organizationId String
  tieId          String
  side           BracketSide
